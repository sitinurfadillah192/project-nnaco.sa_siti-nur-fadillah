APP_ENV=development
APP_URL=http://localhost/nnco_sa/public

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=nnaco_sa

# Mail / SMTP Configuration (PHPMailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@nnacosa.com
MAIL_FROM_NAME=NNACOSA
MAIL_TIMEOUT=15
MAIL_ENABLED=false

# Retry Configuration
MAIL_MAX_RETRIES=5
MAIL_RETRY_DELAY_MINUTES=5

# System Settings Security & Authenticated Encryption (AES-256-GCM)
SYSTEM_ENCRYPTION_KEY=your_64_character_hex_key_here

# AI & Gateway Configuration
AI_API_KEY=your_ai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
FONNTE_TOKEN=your_fonnte_token_here
FONNTE_API_URL=https://api.fonnte.com/send
